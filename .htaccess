Options -Indexes
RewriteEngine On
# Only the public entry points below are web-accessible.
RewriteRule ^api/v1(?:/.*)?$ public/api/index.php [END,QSA]
RewriteRule ^assets/(.+)$ public/assets/$1 [END]
RewriteRule ^$ public/index.html [END]
RewriteRule ^index\.html$ public/index.html [END]
RewriteRule ^public/(?:index\.html|assets/[^.].*)$ - [END]
RewriteRule ^ - [F]
<IfModule mod_headers.c>
 Header always set Referrer-Policy "no-referrer"
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "DENY"
 <FilesMatch "^(index\.html)?$">
  Header always set Cache-Control "no-store, must-revalidate"
 </FilesMatch>
 <FilesMatch "\.(js|css)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
 </FilesMatch>
</IfModule>
