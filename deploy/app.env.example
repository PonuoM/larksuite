; INI format (parsed by PHP parse_ini_file): comments start with a semicolon.
; Copy to deploy/app.env on the server; mounted read-only as the app's .env.
DB_HOST=db
DB_NAME=workboard
DB_USER=workboard_app
; Same value as DB_APP_PASSWORD in deploy/.env (hex, no quotes).
DB_PASSWORD=
APP_BASE=/
APP_ORIGIN=https://larksuite.prima49.com
COOKIE_SECURE=1
; Caddy is the only client of the app container, so the real visitor IP comes from X-Forwarded-For.
TRUST_PROXY=1
