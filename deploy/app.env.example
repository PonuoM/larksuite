; INI format (parsed by PHP parse_ini_file): comments start with a semicolon.
; Copy to deploy/app.env on the server; mounted read-only as the app's .env.
DB_HOST=db
DB_NAME=workboard
DB_USER=workboard_app
; Same value as DB_APP_PASSWORD in deploy/.env (hex, no quotes).
DB_PASSWORD=
APP_BASE=/
APP_ORIGIN=https://larksuite.prima49.com
COOKIE_SECURE=1
; Caddy is the only client of the app container, so the real visitor IP comes from X-Forwarded-For.
TRUST_PROXY=1
; 64 hex chars (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Encrypts permanent
; links so admins can show them again. Changing or losing it only makes stored links unviewable, not invalid.
LINK_KEY=
; Lark custom bots (webhook + signature secret). main = team group, test = test group. Empty = hidden in the UI.
LARK_MAIN_WEBHOOK=
LARK_MAIN_SECRET=
LARK_TEST_WEBHOOK=
LARK_TEST_SECRET=
